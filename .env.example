# TEMPLATE ONLY — this file IS committed. Never put a real key here.
# Copy to `.env` (which is gitignored) and fill that in instead.
#
# These are read by the Cloudflare Pages Function at functions/api/plans.ts,
# which is what talks to Wix. They are NOT Vite variables: they have no VITE_
# prefix on purpose, so they can never be inlined into a client-side bundle.
#
# Local development:
#   npm run dev        Vite only. It proxies /api/plans to the deployed site
#                      (see vite.config.ts), so prices are live without these.
#   npm run dev:full   Builds, then serves via wrangler so the Pages Function
#                      runs locally and reads .env. Use when changing the
#                      Function itself — that is the only thing `dev` cannot test.

# Wix API key with the "Read Pricing Plans" permission scope.
# Create at https://manage.wix.com/account/api-keys
WIX_API_KEY=

# The Freeflydriving site id. Not a secret — safe to keep here.
WIX_SITE_ID=eb31b268-571e-4711-a79e-b3aabdb44f2f
