# Cloudflare Pages headers.
# Rules are matched top-down; the most specific path wins.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # Everything is same-origin and self-contained. The only third parties are the
  # outbound social links in the footer, which need no CSP allowance, and
  # /api/plans, which is same-origin (the Pages Function talks to Wix, the
  # browser never does). blob: and data: are for the Draco worker and the
  # procedurally generated road texture.
  #
  # `connect-src` needs blob: for the GLB's textures, which is not obvious.
  # They are embedded in the .glb rather than being separate files, so
  # GLTFLoader unpacks them into blob: URLs and then loads those. Where
  # `createImageBitmap` exists (every browser that matters) it loads them with
  # ImageBitmapLoader, which is a `fetch()`, so they are governed by
  # connect-src and NOT by the img-src blob: allowance above. Without this the
  # car renders with flat material colours and no texture maps, and the console
  # fills with `GLTFLoader: Couldn't load texture blob:`.
  #
  # This is not a real widening: a blob: URL is same-origin memory this page
  # created itself, not a remote host. default-src 'self' still denies the rest.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'

# Vite fingerprints these, so they can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted, but versioned by hand, so bump the filename if the model
# changes. Long cache is the whole reason the 1.35 MB GLB is acceptable.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/draco/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# The document itself must revalidate or a deploy never reaches anyone.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/credits
  Cache-Control: public, max-age=0, must-revalidate

/credits.html
  Cache-Control: public, max-age=0, must-revalidate
