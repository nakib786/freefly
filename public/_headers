# Cloudflare Pages headers.
# Rules are matched top-down; the most specific path wins.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # Everything is same-origin and self-contained. The only third parties are the
  # outbound social links in the footer, which need no CSP allowance, and
  # /api/plans, which is same-origin (the Pages Function talks to Wix, the
  # browser never does). blob: and data: are for the Draco worker and the
  # procedurally generated road texture.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'

# Vite fingerprints these, so they can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted, but versioned by hand — bump the filename if the model
# changes. Long cache is the whole reason the 1.35 MB GLB is acceptable.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/draco/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# The document itself must revalidate or a deploy never reaches anyone.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
